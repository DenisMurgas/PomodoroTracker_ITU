<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:PomodoroTracker.App.Controls"
             x:Class="PomodoroTracker.App.Controls.NavigationRailItem"
             x:Name="Root">
    <Border HeightRequest="54"
            HorizontalOptions="Fill"
            StrokeThickness="0"
            BackgroundColor="Transparent">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}, x:DataType=controls:NavigationRailItem}"
                                  CommandParameter="{Binding Route, Source={x:Reference Root}, x:DataType=controls:NavigationRailItem}" />
        </Border.GestureRecognizers>
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsSelected, Source={x:Reference Root}, x:DataType=controls:NavigationRailItem}"
                         Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentSoftColor}" />
            </DataTrigger>
        </Border.Triggers>
        <VerticalStackLayout Spacing="4"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Image Source="{Binding Icon, Source={x:Reference Root}, x:DataType=controls:NavigationRailItem}"
                   WidthRequest="18"
                   HeightRequest="18"
                   HorizontalOptions="Center">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{Binding TextColor, Source={x:Reference ItemLabel}, x:DataType=Label}" />
                </Image.Behaviors>
            </Image>
            <Label x:Name="ItemLabel"
                   Text="{Binding Title, Source={x:Reference Root}, x:DataType=controls:NavigationRailItem}"
                   FontFamily="InterMedium"
                   FontSize="11"
                   TextColor="{StaticResource TextNavigationColor}"
                   HorizontalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsSelected, Source={x:Reference Root}, x:DataType=controls:NavigationRailItem}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource AccentColor}" />
                        <Setter Property="FontFamily" Value="InterSemiBold" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>
    </Border>
</ContentView>
