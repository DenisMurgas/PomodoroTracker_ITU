<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}" />

    <Shadow x:Key="FloatingBlockShadow"
            Brush="{StaticResource ShadowBrush}"
            Offset="0,4"
            Radius="12"
            Opacity="0.15" />

    <Shadow x:Key="SoftControlShadow"
            Brush="{StaticResource ShadowBrush}"
            Offset="0,2"
            Radius="5"
            Opacity="0.12" />

    <Style x:Key="PageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundMainColor}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="TimerLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="CharacterSpacing" Value="-0.9" />
    </Style>

    <Style x:Key="PageTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="CardTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="StrongLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="TaskLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ValueLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SmallLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
    </Style>

    <Style x:Key="TinyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundSecondaryColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow" Value="{StaticResource FloatingBlockShadow}" />
    </Style>

    <Style x:Key="SurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Shadow" Value="{StaticResource SoftControlShadow}" />
    </Style>

    <Style x:Key="ButtonBaseStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnDarkColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="DarkButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource DarkColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnDarkColor}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundSecondaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="Shadow" Value="{StaticResource SoftControlShadow}" />
    </Style>

    <Style x:Key="EntryStyle" TargetType="Entry">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondaryColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundSecondaryColor}" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <Style x:Key="PickerStyle" TargetType="Picker">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundSecondaryColor}" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource CheckboxColor}" />
    </Style>

</ResourceDictionary>
